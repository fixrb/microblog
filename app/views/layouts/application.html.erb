<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Microblog</title>
    <%= csrf_meta_tags %>
    <style>
      body { max-width: 40rem; margin: 2rem auto; padding: 0 1rem; font: 1rem/1.5 system-ui, sans-serif; color: #222; }
      header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #ddd; }
      header h1 { font-size: 1.25rem; }
      header h1 a { color: inherit; text-decoration: none; }
      header nav > * { display: inline-block; margin-left: 1rem; }
      article { padding: 1rem 0; border-bottom: 1px solid #eee; }
      article p { margin: .25rem 0; }
      article time, .count { color: #666; font-size: .875rem; }
      form { margin: 1rem 0; }
      textarea, input[type=text] { width: 100%; box-sizing: border-box; font: inherit; padding: .5rem; }
      button, input[type=submit] { font: inherit; padding: .25rem .75rem; }
      .alert, .error { color: #b00020; }
    </style>
  </head>
  <body>
    <header>
      <h1><%= link_to "Microblog", root_path %></h1>
      <nav>
        <% if current_user %>
          <%= link_to "@#{current_user.handle}", current_user %>
          <%= button_to "Sign out", session_path, method: :delete %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
        <% end %>
      </nav>
    </header>

    <% if alert %>
      <p class="alert"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
